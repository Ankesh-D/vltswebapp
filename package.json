{
  "name": "psv-frontend",
  "version": "2.1.48",
  "description": "PSV Modern Frontend - Angular 22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development --base-href /",
    "build:prod": "npm version patch --no-git-tag-version && node version.js && ng build --configuration production --base-href https://vlts.wb.gov.in/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api-interceptor": "ng test --watch=false --include=src/app/core/interceptors/api.interceptor.spec.ts --ts-config=tsconfig.interceptor.spec.json",
    "test:sidebar": "ng test --watch=false --include=src/app/shared/layout/main-layout/sidebar.component.spec.ts --ts-config=tsconfig.sidebar.spec.json",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "@amcharts/amcharts5": "^5.15.3",
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ant-design/icons-angular": "^22.1.1",
    "@ctrl/tinycolor": "^4.2.1",
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "^24.2.1",
    "@popperjs/core": "^2.11.8",
    "@turf/turf": "^7.3.3",
    "@types/leaflet-draw": "^1.0.13",
    "amcharts3": "^3.21.15",
    "bootstrap": "^5.3.8",
    "bootstrap-datepicker": "^1.10.1",
    "bootstrap-icons": "^1.13.2",
    "boxicons": "^2.1.4",
    "crypto-js": "^4.2.0",
    "daterangepicker": "^3.1.0",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "font-awesome": "^4.7.0",
    "jquery": "^4.0.0",
    "leaflet": "1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.markercluster": "^1.5.3",
    "mapbox-gl": "^2.15.0",
    "moment": "^2.31.0",
    "ng-zorro-antd": "^22.1.2",
    "ngx-bootstrap": "^22.0.0",
